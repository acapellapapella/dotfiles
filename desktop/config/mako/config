# Palette: plum & lilac from the wallpaper (see waybar-niri/style.css).
# niri blurs the wallpaper behind the translucent background (layerrules.kdl).
font=Onest 10
width=340
padding=12,14
margin=10
outer-margin=6
border-size=1
border-radius=12
max-icon-size=32
icon-location=left

background-color=#1a1419d9
text-color=#ece0ee
border-color=#ecd9f01f
progress-color=over #3a2e38

format=<span size='small' foreground='#9a8a98'>%a</span>\n<b>%s</b>\n%b
default-timeout=4500
max-visible=5
anchor=top-right
layer=top

[urgency=low]
text-color=#9a8a98

[urgency=critical]
border-color=#c46a80
default-timeout=0
