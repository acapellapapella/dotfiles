/* Palette: plum & lilac from the wallpaper (see waybar-niri/style.css). */
* {
    bg: rgba(15,11,16,0.0);
    surface: rgba(236,224,238,0.06);
    surface-hi: rgba(236,224,238,0.13);
    border: rgba(236,224,238,0.08);
    border-hi: rgba(220,195,228,0.45);
    fg: #ece0ee;
    fg-dim: #9a8a98;
    fg-hi: #ffffff;
    accent: #dcc3e4;
    background-color: transparent;
    text-color: @fg;
    font: "Onest 11";
}

window {
    width: 880px;
    background-color: rgba(20,15,20,0.55);
    border: 1px;
    border-color: @border;
    border-radius: 22px;
    padding: 26px;
}

mainbox {
    background-color: transparent;
    orientation: horizontal;
    spacing: 24px;

    children: [
        left-box,
        listview
    ];
}

left-box {
    background-color: transparent;
    orientation: vertical;
    width: 240px;
    expand: false;
    children: [ inputbar ];
}

inputbar {
    background-color: transparent;
    vertical-align: 0.0;
    children: [ entry ];
}

entry {
    background-color: rgba(236,224,238,0.07);
    text-color: @fg-hi;
    placeholder-color: @fg-dim;
    placeholder: "Search...";
    border: 1px;
    border-color: @border;
    border-radius: 14px;
    padding: 14px 16px;
    font: "Onest Medium 13";
}

listview {
    background-color: transparent;
    columns: 3;
    lines: 4;
    flow: horizontal;
    cycle: true;
    spacing: 12px;
    scrollbar: false;
    dynamic: false;
}

element {
    background-color: @surface;
    border: 1px;
    border-color: transparent;
    border-radius: 16px;
    orientation: horizontal;
    padding: 14px 18px;
    spacing: 14px;
}

element normal.normal {
    background-color: @surface;
    text-color: @fg;
}

element selected.normal {
    background-color: @surface-hi;
    border: 1px;
    border-color: @border-hi;
    text-color: @fg-hi;
}

element-icon {
    size: 28px;
    background-color: transparent;
    horizontal-align: 0.0;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: @fg;
    horizontal-align: 0.0;
    vertical-align: 0.5;
    font: "Onest Medium 10.5";
}

element-text selected {
    text-color: @fg-hi;
}

mode-switcher,
message,
textbox,
prompt,
case-indicator {
    enabled: false;
}

overlay {
    background-color: transparent;
}
