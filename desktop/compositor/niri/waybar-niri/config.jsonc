// midve bar: plum glass along the top edge (blur from niri, layerrules.kdl).
// Quiet lilac glyphs, values in Inter. Palette: see style.css.
[
  {
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,
    "exclusive": true,
    "gtk-layer-shell": true,

    "modules-left": ["clock", "custom/spotify"],
    "modules-center": ["niri/workspaces"],
    "modules-right": [
      "memory",
      "pulseaudio",
      "network",
      "bluetooth",
      "niri/language",
      "custom/ai",
      "tray"
    ],

    "clock": {
      "format": "<span weight='600'>{0:%H:%M}</span>  <span foreground='#8a7a88'>{0:%a %d %b}</span>",
      "tooltip-format": "<tt>{calendar}</tt>",
      "calendar": {
        "mode": "month",
        "format": {
          "months": "<span foreground='#ece0ee'><b>{}</b></span>",
          "weekdays": "<span foreground='#8a7a88'>{}</span>",
          "today": "<span foreground='#dcc3e4'><b><u>{}</u></b></span>"
        }
      }
    },

    "custom/spotify": {
      // https://github.com/acapellapapella/dbus-media-track — prints an empty
      // line while paused, which hides the module.
      "exec": "~/.local/bin/dbus-media-track --service --player spotify --artist \"—\" --title",
      "format": "<span foreground='#dcc3e4'>󰎈</span>  {}",
      "escape": true,
      "max-length": 56,
      "return-type": "plain",
      "interval": 0,
      "tooltip": false
    },

    "niri/workspaces": {
      "format": ""
    },

    "memory": {
      "format": "<span foreground='#a58fa6'>󰍛</span>  {percentage}%",
      "interval": 5,
      "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "pulseaudio": {
      "format": "<span foreground='#a58fa6'>󰕾</span>  {volume}%",
      "format-bluetooth": "<span foreground='#a58fa6'>󰋋</span>  {volume}%",
      "format-bluetooth-muted": "<span foreground='#a58fa6'>󰟎</span>  muted",
      "format-muted": "<span foreground='#a58fa6'>󰖁</span>  muted",
      "max-volume": 150,
      "on-click": "pavucontrol",
      "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 2%+ --limit 1.5",
      "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 2%-",
      "tooltip-format": "{desc}"
    },

    "network": {
      "format-ethernet": "<span foreground='#a58fa6'>󰈀</span>",
      "format-wifi": "<span foreground='#a58fa6'>󰤨</span>  {essid}",
      "format-disconnected": "<span foreground='#a58fa6'>󰤭</span>",
      "tooltip-format-ethernet": "{ifname}  ·  {ipaddr}",
      "tooltip-format-wifi": "{essid}  ·  {signalStrength}%\n{ipaddr}",
      "on-click": "kitty -e nmtui",
      "interval": 5
    },

    "bluetooth": {
      "format": "<span foreground='#a58fa6'>󰂯</span>",
      "format-off": "",
      "format-disabled": "",
      "format-connected": "<span foreground='#a58fa6'>󰂱</span>  {device_alias}",
      "tooltip-format": "{controller_alias}",
      "tooltip-format-connected": "{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}",
      "on-click": "blueman-manager"
    },

    "niri/language": {
      "format": "{short}",
      "tooltip-format": "{long}"
    },

    "custom/ai": {
      "format": "󰚩",
      "on-click": "bash -c '~/.local/bin/to_ai.sh'",
      "tooltip": false
    },

    "tray": {
      "icon-size": 14,
      "spacing": 8,
      "show-passive-items": false
    }
  }
]
