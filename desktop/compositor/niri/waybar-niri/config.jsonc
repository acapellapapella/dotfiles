// midve bar: plum glass along the top edge (blur from niri, layerrules.kdl).
// No icons: a quiet lowercase word names each value, and a module only shows
// when it has something to say (network only when it's down, the track only
// while playing, the audio device's own name when it isn't the default).
// Palette: see style.css.
[
  {
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,
    "exclusive": true,
    "gtk-layer-shell": true,

    "modules-left": ["custom/ws", "clock", "custom/spotify"],
    "modules-center": ["cffi/drops"],
    "modules-right": ["network", "memory", "pulseaudio", "niri/language", "custom/ai", "tray"],

    // The active workspace's number in the corner, set apart from the clock by
    // a hairline (scripts/niri-ws-number follows niri's event stream).
    "custom/ws": {
      "exec": "~/.local/bin/niri-ws-number DP-1",
      "return-type": "json",
      "restart-interval": 2,
      "escape": true
    },

    "clock": {
      "format": "<span weight='600'>{0:%H:%M}</span>  <span foreground='#8a7a88'>{0:%a %d %b}</span>",
      "tooltip-format": "<tt>{calendar}</tt>",
      "calendar": {
        "mode": "month",
        "format": {
          "months": "<span foreground='#ece0ee'><b>{}</b></span>",
          "weekdays": "<span foreground='#8a7a88'>{}</span>",
          "today": "<span foreground='#dcc3e4'><b><u>{}</u></b></span>"
        }
      }
    },

    "custom/spotify": {
      // https://github.com/acapellapapella/dbus-media-track — prints an empty
      // line while paused, which hides the module.
      "exec": "~/.local/bin/dbus-media-track --service --player spotify --artist \"—\" --title",
      "escape": true,
      "max-length": 60,
      "return-type": "plain",
      "interval": 0,
      "tooltip": false
    },

    // Workspaces: dots with a drop of lilac that runs between them
    // (drops/drops.c, built and installed by install.sh).
    "cffi/drops": {
      "module_path": "/home/midv/.local/lib/waybar/niri-drops.so",
      "output": "DP-1"
    },

    "network": {
      "format-ethernet": "",
      "format-wifi": "",
      "format-linked": "<span foreground='#8a7a88'>net</span>  no ip",
      "format-disconnected": "offline",
      "tooltip-format-disconnected": "No network connection",
      "on-click": "kitty -e nmtui",
      "interval": 5
    },

    "memory": {
      "format": "<span foreground='#8a7a88'>ram</span>  {percentage}%",
      "interval": 5,
      "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "pulseaudio": {
      "format": "<span foreground='#8a7a88'>vol</span>  {volume}%",
      "format-bluetooth": "<span foreground='#8a7a88'>{desc}</span>  {volume}%",
      "format-muted": "<span foreground='#8a7a88'>vol</span>  muted",
      "format-bluetooth-muted": "<span foreground='#8a7a88'>{desc}</span>  muted",
      "max-volume": 150,
      "on-click": "pavucontrol",
      "on-click-right": "blueman-manager",
      "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 2%+ --limit 1.5",
      "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 2%-",
      "tooltip-format": "{desc}\nclick: mixer · right click: bluetooth"
    },

    "niri/language": {
      "format": "{short}",
      "tooltip-format": "{long}"
    },

    "custom/ai": {
      "format": "ai",
      "on-click": "bash -c '~/.local/bin/to_ai.sh'",
      "tooltip-format": "Open ChatGPT in Helium"
    },

    "tray": {
      "icon-size": 14,
      "spacing": 8,
      "show-passive-items": false
    }
  }
]
