diff --git a/src/render_helpers/shaders/tilt.frag b/src/render_helpers/shaders/tilt.frag
new file mode 100644
index 00000000..c47855da
--- /dev/null
+++ b/src/render_helpers/shaders/tilt.frag
@@ -0,0 +1,127 @@
+// midve: a workspace card in the overview, drawn with real perspective.
+//
+// The quad covers the card's projected bounding box plus room for its shadow.
+// For every pixel, tilt_input_to_uv (the inverse of the card's homography)
+// gives the point on the flat card it shows; the card's texture is sampled
+// there. Outside the card: a soft shadow, and a lilac glow on the current
+// workspace.
+
+precision highp float;
+
+#if defined(DEBUG_FLAGS)
+uniform float niri_tint;
+#endif
+
+varying vec2 niri_v_coords;
+uniform vec2 niri_size;
+uniform float niri_scale;
+uniform float niri_alpha;
+
+uniform sampler2D niri_tex;
+uniform mat3 tilt_input_to_uv;
+uniform mat3 tilt_uv_to_tex;
+// The card's size in physical pixels: turns uv distances into pixels for
+// antialiased edges and the shadow falloff.
+uniform vec2 tilt_card_px;
+// 0..1: the lilac rim and glow of the current workspace.
+uniform float tilt_glow;
+// 0..1: a short lilac flash along the rim when a card seats into its slot.
+uniform float tilt_flash;
+// One physical pixel in quad coordinates, and the texture's size in texels: together they give
+// each pixel's footprint on the texture for the adaptive filter.
+uniform vec2 tilt_px;
+uniform vec2 tilt_tex_px;
+// 0..1: the card's frame (rounded corners, hairline, shadow). It goes to 0 as the card becomes
+// the whole output, so entering a workspace lands without a pop.
+uniform float tilt_frame;
+// A soft glint crossing the card once (it turned to face the pointer): 0..1 across, or < 0.
+uniform float tilt_glint;
+
+vec4 card_tap(vec2 at) {
+    vec3 q = tilt_input_to_uv * vec3(at, 1.0);
+    vec2 uv = clamp(q.xy / q.z, 0.0, 1.0);
+    vec3 t = tilt_uv_to_tex * vec3(uv, 1.0);
+    return texture2D(niri_tex, t.st);
+}
+
+vec2 card_tex_at(vec2 at) {
+    vec3 q = tilt_input_to_uv * vec3(at, 1.0);
+    vec3 t = tilt_uv_to_tex * vec3(q.xy / q.z, 1.0);
+    return t.st;
+}
+
+// Adaptive supersampling over the pixel's own footprint on the texture: one bilinear tap where
+// the texture is magnified or 1:1 (no extra softening), and an n×m grid of taps (up to 4×4)
+// where the perspective squeezes several texels into one pixel, so receding text and lines
+// neither blur nor shimmer.
+vec4 card_filtered(vec2 c) {
+    vec2 t0 = card_tex_at(c);
+    vec2 du = (card_tex_at(c + vec2(tilt_px.x, 0.0)) - t0) * tilt_tex_px;
+    vec2 dv = (card_tex_at(c + vec2(0.0, tilt_px.y)) - t0) * tilt_tex_px;
+    int nx = int(clamp(ceil(length(du) - 0.15), 1.0, 4.0));
+    int ny = int(clamp(ceil(length(dv) - 0.15), 1.0, 4.0));
+    vec4 sum = vec4(0.0);
+    for (int j = 0; j < 4; j++) {
+        if (j >= ny) break;
+        for (int i = 0; i < 4; i++) {
+            if (i >= nx) break;
+            vec2 o = vec2((float(i) + 0.5) / float(nx) - 0.5, (float(j) + 0.5) / float(ny) - 0.5);
+            sum += card_tap(c + tilt_px * o);
+        }
+    }
+    return sum / float(nx * ny);
+}
+
+void main() {
+    vec4 color = vec4(0.0);
+    vec3 q = tilt_input_to_uv * vec3(niri_v_coords, 1.0);
+
+    if (q.z > 0.0) {
+        vec2 uv = q.xy / q.z;
+        // Rounded rectangle in the card's own pixels (signed distance, < 0 inside), with the
+        // same soft corners as the HUD's panels.
+        float r = max(10.0 * niri_scale * tilt_frame, 0.001);
+        vec2 half_px = tilt_card_px * 0.5;
+        vec2 d2 = abs(uv * tilt_card_px - half_px) - (half_px - vec2(r));
+        float sd = length(max(d2, 0.0)) + min(max(d2.x, d2.y), 0.0) - r;
+        float inside = -sd;
+        float outside = max(sd, 0.0);
+
+        // the card itself, antialiased to one pixel
+        float cover = clamp(inside + 0.5, 0.0, 1.0);
+        if (cover > 0.0) {
+            vec4 c = card_filtered(niri_v_coords);
+            float rim = (tilt_glow * 0.85 + tilt_flash) * (1.0 - smoothstep(0.0, 2.5 * niri_scale, inside));
+            c = mix(c, vec4(0.863, 0.765, 0.894, 1.0), clamp(rim, 0.0, 1.0));
+            // every card: a faint hairline along its edge, like the panels' borders
+            float hair = 0.14 * tilt_frame * (1.0 - smoothstep(0.0, 1.2 * niri_scale, inside)) * (1.0 - tilt_glow);
+            c = mix(c, vec4(0.925, 0.878, 0.933, 1.0), hair);
+            // the glint: a soft band, like light on glass, from the upper left to the lower
+            // right; it swells in the middle of its way and is gone at both ends
+            if (tilt_glint >= 0.0) {
+                vec2 p = uv * tilt_card_px;
+                float s = (p.x + 0.55 * p.y) / (tilt_card_px.x + 0.55 * tilt_card_px.y);
+                float d = (s - mix(-0.2, 1.2, tilt_glint)) / 0.075;
+                float g = 0.10 * exp(-d * d) * sin(3.14159265 * tilt_glint);
+                c.rgb += vec3(0.96, 0.93, 0.98) * g * c.a;
+            }
+            color = c * cover;
+        }
+
+        // shadow below, lilac glow around the current one (premultiplied, under the card)
+        float s = niri_scale;
+        float shadow = 0.34 * tilt_frame * exp(-outside / (14.0 * s)) * (1.0 - cover);
+        float glow = (0.28 * tilt_glow + 0.5 * tilt_flash) * exp(-outside / (9.0 * s)) * (1.0 - cover);
+        vec4 under = vec4(0.024, 0.008, 0.02, 1.0) * shadow + vec4(0.863, 0.765, 0.894, 1.0) * glow;
+        color = color + under * (1.0 - color.a);
+    }
+
+    color = color * niri_alpha;
+
+#if defined(DEBUG_FLAGS)
+    if (niri_tint == 1.0)
+        color = vec4(0.0, 0.2, 0.0, 0.2) + color * 0.8;
+#endif
+
+    gl_FragColor = color;
+}
diff --git a/src/render_helpers/shaders/tilt_label.frag b/src/render_helpers/shaders/tilt_label.frag
new file mode 100644
index 00000000..0e515b0a
--- /dev/null
+++ b/src/render_helpers/shaders/tilt_label.frag
@@ -0,0 +1,35 @@
+// midve: a workspace card's label, drawn in the card's own plane.
+//
+// tilt_input_to_uv maps the element's quad to the label's uv (the inverse of
+// the label's homography); outside 0..1 nothing is drawn. The label texture has
+// a transparent border, so its edges need no extra antialiasing.
+
+precision highp float;
+
+#if defined(DEBUG_FLAGS)
+uniform float niri_tint;
+#endif
+
+varying vec2 niri_v_coords;
+uniform float niri_alpha;
+
+uniform sampler2D niri_tex;
+uniform mat3 tilt_input_to_uv;
+
+void main() {
+    vec4 color = vec4(0.0);
+    vec3 q = tilt_input_to_uv * vec3(niri_v_coords, 1.0);
+    if (q.z > 0.0) {
+        vec2 uv = q.xy / q.z;
+        if (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0)
+            color = texture2D(niri_tex, uv);
+    }
+    color = color * niri_alpha;
+
+#if defined(DEBUG_FLAGS)
+    if (niri_tint == 1.0)
+        color = vec4(0.0, 0.2, 0.0, 0.2) + color * 0.8;
+#endif
+
+    gl_FragColor = color;
+}
