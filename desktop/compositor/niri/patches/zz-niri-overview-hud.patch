+/// midve: stretch an animation for a longer trip. A spring (or easing) takes the same time for
+/// any distance, so jumping two workspaces or columns at once moves twice as fast and reads as
+/// a jerk. With this, time grows as the square root of the distance in "units" (one workspace,
+/// one view width), capped at 2× for 4 units and more; a single step is unchanged.
+pub fn scaled_for_distance(config: niri_config::Animation, units: f64) -> niri_config::Animation {
+    let units = units.abs().clamp(1., 4.);
+    if units <= 1.001 {
+        return config;
+    }
+    let mut config = config;
+    match &mut config.kind {
+        // Critically damped spring: settle time ∝ 1/√stiffness, so stiffness / units gives √units.
