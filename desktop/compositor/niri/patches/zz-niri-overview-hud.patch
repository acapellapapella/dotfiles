+    let num = pangocairo::glib::markup_escape_text(&num);
+    let color = if active { "#dcc3e4" } else { "#ece0ee" };
+    let mut s = format!("<span weight='600' foreground='{color}'>{num}</span>");
+    if apps.is_empty() {
+        s.push_str("<span foreground='#6f606d'>   empty</span>");
+    } else {
+        let list = apps.iter().map(|a| pangocairo::glib::markup_escape_text(a).to_string()).collect::<Vec<_>>().join(" · ");
+        s.push_str(&format!("<span foreground='#9a8a98'>   {list}</span>"));
+    }
+    s
+}
