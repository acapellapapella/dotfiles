--- /dev/null
+++ b/src/layout/overview_tilt.rs
@@ -0,0 +1,398 @@
+//! midve: overview workspace cards drawn with real perspective.
+//!
+//! Each visible workspace is rendered into its own offscreen texture (the
+//! offscreen's damage tracker only redraws what changed), then shown through
+//! the `Tilt` shader with the inverse of the card's homography. The shader
+//! element keeps one id per workspace and is only updated when the content or
+//! the tilt parameters change, so a still overview causes no damage.
+
+use std::collections::HashMap;
+use std::rc::Rc;
+
+use glam::{Mat3, Vec2, Vec3};
+use smithay::backend::renderer::element::{Element as _, Kind, RenderElement};
+use smithay::backend::renderer::gles::{GlesRenderer, Uniform};
+use smithay::backend::renderer::utils::CommitCounter;
+use smithay::backend::renderer::Texture as _;
+use smithay::utils::{Logical, Point, Rectangle, Scale, Size};
+
+use crate::render_helpers::offscreen::{OffscreenBuffer, OffscreenData};
+use crate::render_helpers::shader_element::ShaderRenderElement;
+use crate::render_helpers::shaders::{mat3_uniform, ProgramType, Shaders};
+
+/// Room around a card for its shadow and glow, in logical px.
+const SHADOW_MARGIN: f64 = 44.;
+
+/// How a card is posed this frame.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct TiltPose {
+    /// Rotation about the card's vertical axis, radians. Negative turns the right edge away.
+    pub angle: f64,
+    /// Distance towards the viewer, logical px.
+    pub z: f64,
+    pub alpha: f32,
+    /// Lilac rim and glow of the current workspace, 0..1.
+    pub glow: f32,
+    /// Short flash when the card seats into its slot, 0..1.
+    pub flash: f32,
+    /// A soft glint crossing the card (it turned to face the pointer): how far it has gone,
+    /// 0..1, or -1 for none.
+    pub glint: f32,
+    /// Vertical drift of the idle sway, logical px (down is positive).
+    pub dy: f64,
+    /// The card's frame (rounded corners, hairline, shadow), 0..1: none when it is the output.
+    pub frame: f32,
+}
+
+impl TiltPose {
+    /// The card's rect moved by the pose's drift.
+    pub fn placed(&self, card: Rectangle<f64, Logical>) -> Rectangle<f64, Logical> {
+        Rectangle::new(Point::from((card.loc.x, card.loc.y + self.dy)), card.size)
+    }
+}
+
+/// midve: the idle sway of everything in the open overview (cards and HUD flanks), at time
+/// `t` (seconds) for an object with its own `seed`: (turn, drift, depth), each about -1..1.
+/// Each is a sum of two slow sines with periods that never line up (5.7–13.1 s), and each
+/// object has its own phases, so the motion doesn't read as a loop and nothing moves in step.
+pub fn idle_sway(t: f64, seed: f64) -> (f64, f64, f64) {
+    use std::f64::consts::TAU;
+    let w = |period: f64, phase: f64| (TAU * t / period + phase).sin();
+    let turn = 0.6 * w(9.3, seed * 2.17) + 0.4 * w(5.7, seed * 4.31 + 1.);
+    let drift = 0.6 * w(7.9, seed * 1.37 + 2.) + 0.4 * w(13.1, seed * 3.71);
+    let depth = 0.7 * w(11.3, seed * 5.13 + 0.5) + 0.3 * w(6.7, seed * 2.89);
+    (turn, drift, depth)
+}
+
+#[derive(Debug, Default)]
+pub struct TiltCard {
+    buffer: OffscreenBuffer,
+    elem: Option<ShaderRenderElement>,
+    /// What the element was last updated for: the offscreen content and the quantised pose.
+    key: Option<(CommitCounter, [i64; 11])>,
+}
+
+/// Homography from the card's uv (0..1) to output-logical coordinates (homogeneous), for a
+/// card rotated about its vertical axis and moved by `z`, seen in perspective from the middle
+/// of the output.
+pub fn card_homography(
+    card: Rectangle<f64, Logical>,
+    view: Size<f64, Logical>,
+    angle: f64,
+    z: f64,
+) -> Mat3 {
+    let (w, h) = (card.size.w, card.size.h);
+    let cx = card.loc.x + w / 2.;
+    let cy = card.loc.y + h / 2.;
+    let (pcx, pcy) = (view.w / 2., view.h / 2.);
+    // Perspective distance: about 0.7 of the output width, like the mockup's 1700px on 2457px.
+    let d = (view.w * 0.7).max(1.);
+    let (s, c) = angle.sin_cos();
+    let z0 = z - s * w / 2.;
+
+    // Rows of H: (sx·w', sy·w', w') in terms of (u, v, 1).
+    let r0 = [w * (c - pcx * s / d), 0., cx - c * w / 2. - pcx * z0 / d];
+    let r1 = [-pcy * s * w / d, h, cy - h / 2. - pcy * z0 / d];
+    let r2 = [-s * w / d, 0., 1. - z0 / d];
+    let col = |j: usize| Vec3::new(r0[j] as f32, r1[j] as f32, r2[j] as f32);
+    Mat3::from_cols(col(0), col(1), col(2))
+}
+
+/// The point on a posed card (its uv, 0..1 inside) that is drawn at `pos` on the output, in
+/// f64: the inverse of `card_homography`. None if `pos` is behind the viewer.
+pub fn unproject(
+    card: Rectangle<f64, Logical>,
+    view: Size<f64, Logical>,
+    angle: f64,
+    z: f64,
+    pos: Point<f64, Logical>,
+) -> Option<(f64, f64)> {
+    let m = card_homography(card, view, angle, z).as_dmat3().inverse();
+    let q = m * glam::DVec3::new(pos.x, pos.y, 1.);
+    (q.z.abs() > 1e-12).then(|| (q.x / q.z, q.y / q.z))
+}
+
+fn project(m: Mat3, u: f32, v: f32) -> Option<Vec2> {
+    let p = m * Vec3::new(u, v, 1.);
+    (p.z > 1e-4).then(|| Vec2::new(p.x / p.z, p.y / p.z))
+}
+
+impl TiltCard {
+    #[allow(clippy::too_many_arguments)]
+    pub fn render(
+        &mut self,
+        renderer: &mut GlesRenderer,
+        elements: &[impl RenderElement<GlesRenderer>],
+        card: Rectangle<f64, Logical>,
+        // Where the card is in the elements' own space (they are drawn at a fixed zoom).
+        tex_card: Rectangle<f64, Logical>,
+        view: Size<f64, Logical>,
+        scale: Scale<f64>,
+        pose: TiltPose,
+    ) -> Option<(ShaderRenderElement, OffscreenData)> {
+        Shaders::get(renderer).program(ProgramType::Tilt)?;
+        if card.size.w < 1. || card.size.h < 1. {
+            return None;
+        }
+
+        // The offscreen redraws into its texture only while nothing else holds it; otherwise it
+        // allocates a new one and redraws the whole workspace, every frame. Let go of it here.
+        drop(self.elem.as_mut().map(|e| e.take_textures()));
+
+        let (off, _sync, mut data) = match self.buffer.render(renderer, scale, elements) {
+            Ok(x) => x,
+            Err(err) => {
+                warn!("error rendering overview card to offscreen: {err:?}");
+                return None;
+            }
+        };
+
+        let hm = card_homography(pose.placed(card), view, pose.angle, pose.z);
+        let inv = hm.inverse();
+
+        // The quad: the projected corners' bounding box, grown for the shadow, on physical px.
+        let corners = [(0., 0.), (1., 0.), (0., 1.), (1., 1.)].map(|(u, v)| project(hm, u, v));
+        if corners.iter().any(|c| c.is_none()) {
+            return None;
+        }
+        let corners = corners.map(|c| c.unwrap());
+        let min = corners.iter().fold(Vec2::splat(f32::MAX), |a, c| a.min(*c));
+        let max = corners.iter().fold(Vec2::splat(f32::MIN), |a, c| a.max(*c));
+        let m = SHADOW_MARGIN as f32;
+        let loc = Point::<f64, Logical>::from(((min.x - m) as f64, (min.y - m) as f64))
+            .to_physical_precise_floor(scale)
+            .to_logical(scale);
+        let end = Point::<f64, Logical>::from(((max.x + m) as f64, (max.y + m) as f64))
+            .to_physical_precise_ceil(scale)
+            .to_logical(scale);
+        let area = Rectangle::new(loc, Size::from((end.x - loc.x, end.y - loc.y)));
+
+        let area_loc = Vec2::new(area.loc.x as f32, area.loc.y as f32);
+        let area_size = Vec2::new(area.size.w as f32, area.size.h as f32);
+        let input_to_uv = inv * Mat3::from_translation(area_loc) * Mat3::from_scale(area_size);
+
+        // uv on the card -> texture coordinates of the offscreen.
+        let texture = off.texture().clone();
+        let tex_scale = Vec2::new(scale.x as f32, scale.y as f32);
+        let tex_size = Vec2::new(texture.width() as f32, texture.height() as f32) / tex_scale;
+        let tex_loc = Vec2::new(off.offset().x as f32, off.offset().y as f32);
+        let tcard_loc = Vec2::new(tex_card.loc.x as f32, tex_card.loc.y as f32);
+        let tcard_size = Vec2::new(tex_card.size.w as f32, tex_card.size.h as f32);
+        let uv_to_tex = Mat3::from_scale(Vec2::ONE / tex_size)
+            * Mat3::from_translation(tcard_loc - tex_loc)
+            * Mat3::from_scale(tcard_size);
+        let card_size = Vec2::new(card.size.w as f32, card.size.h as f32);
+        let card_px = card_size * tex_scale;
+
+        // Update the element only when something changed, so a still overview has no damage.
+        let q = |x: f64, k: f64| (x * k).round() as i64;
+        let key = (
+            off.current_commit(),
+            [
+                q(area.loc.x, 64.),
+                q(area.loc.y, 64.),
+                q(area.size.w, 64.),
+                q(area.size.h, 64.),
+                q(pose.angle, 1e5),
+                q(pose.z, 64.),
+                q(pose.alpha as f64, 1e3),
+                q(pose.glow as f64, 1e3),
+                q(pose.flash as f64, 1e3),
+                q(pose.frame as f64, 1e3),
+                q(pose.glint as f64, 1e3),
+            ],
+        );
+
+        let tex_px = [texture.width() as f32, texture.height() as f32];
+        let uniforms: Rc<[Uniform<'static>]> = Rc::new([
+            Uniform::new("tilt_tex_px", tex_px),
+            Uniform::new("tilt_frame", pose.frame),
+            mat3_uniform("tilt_input_to_uv", input_to_uv),
+            mat3_uniform("tilt_uv_to_tex", uv_to_tex),
+            Uniform::new("tilt_card_px", card_px.to_array()),
+            Uniform::new("tilt_glow", pose.glow),
+            Uniform::new("tilt_flash", pose.flash),
+            Uniform::new("tilt_glint", pose.glint),
+            Uniform::new(
+                "tilt_px",
+                [
+                    (1. / (area.size.w * scale.x)) as f32,
+                    (1. / (area.size.h * scale.y)) as f32,
+                ],
+            ),
+        ]);
+        let textures = HashMap::from([(String::from("niri_tex"), texture)]);
+
+        let elem = self
+            .elem
+            .get_or_insert_with(|| ShaderRenderElement::empty(ProgramType::Tilt, Kind::Unspecified));
+        if self.key != Some(key) {
+            elem.update(area.size, None, scale.x as f32, pose.alpha, uniforms, textures);
+            self.key = Some(key);
+        } else {
+            // Same texture and contents: no damage.
+            elem.restore_textures(textures);
+        }
+        let elem = elem.clone().with_location(area.loc);
+
+        // Surfaces drawn into the offscreen count as presented through this element.
+        data.id = elem.id().clone();
+        Some((elem, data))
+    }
+}
+
+/// Gap between a card's bottom edge and its label, in the card's plane (logical px).
+pub const LABEL_GAP: f64 = 6.;
+
+/// midve: a card's label, "3  kitty · firefox". It lies in the card's own plane, under its
+/// bottom edge, so it turns, recedes and comes forward with the card. The text is drawn once
+/// per text, scale and width; the element is updated only when the text or the pose changes.
+#[derive(Debug, Default)]
+pub struct CardLabel {
+    key: Option<(String, i64, i64)>,
+    buffer: Option<crate::render_helpers::texture::TextureBuffer<smithay::backend::renderer::gles::GlesTexture>>,
+    elem: Option<ShaderRenderElement>,
+    elem_key: Option<[i64; 7]>,
+}
+
+impl CardLabel {
+    #[allow(clippy::too_many_arguments)]
+    pub fn render(
+        &mut self,
+        renderer: &mut GlesRenderer,
+        markup: &str,
+        card: Rectangle<f64, Logical>,
+        view: Size<f64, Logical>,
+        scale: f64,
+        max_h: f64,
+        slot_w: f64,
+        pose: TiltPose,
+        alpha: f32,
+    ) -> Option<ShaderRenderElement> {
+        Shaders::get(renderer).program(ProgramType::TiltLabel)?;
+        if card.size.w < 1. || card.size.h < 1. {
+            return None;
+        }
+        // The text is laid out once for the card's size in the open overview (`slot_w`) and
+        // scaled with the card while it moves, so the opening never re-renders it per frame.
+        let slot_w = slot_w.max(1.);
+        let cam = card.size.w / slot_w;
+        let key = (markup.to_owned(), (scale * 1000.) as i64, slot_w.round() as i64);
+        let text_changed = self.key.as_ref() != Some(&key);
+        if text_changed {
+            self.buffer = render_label(renderer, markup, scale, slot_w)
+                .map_err(|err| warn!("error rendering an overview label: {err:?}"))
+                .ok();
+            self.key = Some(key);
+            self.elem_key = None;
+        }
+        let buffer = self.buffer.as_ref()?;
+        let size = buffer.logical_size().upscale(cam);
+        // Never taller than the room between rows: shrink rather than reach the next card.
+        let k = if size.h > max_h && max_h > 0. { max_h / size.h } else { 1. };
+        let (lw, lh) = (size.w * k, size.h * k);
+
+        // Label uv -> card uv (centred under the bottom edge) -> screen.
+        let (w, h) = (card.size.w, card.size.h);
+        let u0 = (w - lw) / 2. / w;
+        let v0 = 1. + LABEL_GAP / h;
+        let to_card = Mat3::from_cols(
+            Vec3::new((lw / w) as f32, 0., 0.),
+            Vec3::new(0., (lh / h) as f32, 0.),
+            Vec3::new(u0 as f32, v0 as f32, 1.),
+        );
+        let hm = card_homography(pose.placed(card), view, pose.angle, pose.z) * to_card;
+
+        let corners = [(0., 0.), (1., 0.), (0., 1.), (1., 1.)].map(|(u, v)| project(hm, u, v));
+        if corners.iter().any(|c| c.is_none()) {
+            return None;
+        }
+        let corners = corners.map(|c| c.unwrap());
+        let min = corners.iter().fold(Vec2::splat(f32::MAX), |a, c| a.min(*c));
+        let max = corners.iter().fold(Vec2::splat(f32::MIN), |a, c| a.max(*c));
+        let scale_xy = Scale::from(scale);
+        let loc = Point::<f64, Logical>::from(((min.x - 1.) as f64, (min.y - 1.) as f64))
+            .to_physical_precise_floor(scale_xy)
+            .to_logical(scale_xy);
+        let end = Point::<f64, Logical>::from(((max.x + 1.) as f64, (max.y + 1.) as f64))
+            .to_physical_precise_ceil(scale_xy)
+            .to_logical(scale_xy);
+        let area = Rectangle::new(loc, Size::from((end.x - loc.x, end.y - loc.y)));
+        let area_loc = Vec2::new(area.loc.x as f32, area.loc.y as f32);
+        let area_size = Vec2::new(area.size.w as f32, area.size.h as f32);
+        let input_to_uv = hm.inverse() * Mat3::from_translation(area_loc) * Mat3::from_scale(area_size);
+
+        let q = |x: f64, k: f64| (x * k).round() as i64;
+        let ekey = [
+            q(area.loc.x, 64.),
+            q(area.loc.y, 64.),
+            q(area.size.w, 64.),
+            q(area.size.h, 64.),
+            q(pose.angle, 1e5),
+            q(pose.z, 64.),
+            q(alpha as f64, 1e3),
+        ];
+        let elem = self.elem.get_or_insert_with(|| {
+            ShaderRenderElement::empty(ProgramType::TiltLabel, Kind::Unspecified)
+        });
+        if self.elem_key != Some(ekey) {
+            let uniforms: Rc<[Uniform<'static>]> =
+                Rc::new([mat3_uniform("tilt_input_to_uv", input_to_uv)]);
+            let textures = HashMap::from([(String::from("niri_tex"), buffer.texture().clone())]);
+            elem.update(area.size, None, scale as f32, alpha, uniforms, textures);
+            self.elem_key = Some(ekey);
+        }
+        Some(elem.clone().with_location(area.loc))
+    }
+}
+
+fn render_label(
+    renderer: &mut GlesRenderer,
+    markup: &str,
+    scale: f64,
+    max_w: f64,
+) -> anyhow::Result<crate::render_helpers::texture::TextureBuffer<smithay::backend::renderer::gles::GlesTexture>> {
+    use pangocairo::cairo::{self, ImageSurface};
+    use pangocairo::pango::{EllipsizeMode, FontDescription};
+
+    let mut font = FontDescription::from_string("Onest 13px");
+    font.set_absolute_size((13. * scale * f64::from(pangocairo::pango::SCALE)).round());
+    let width = ((max_w * scale).floor() as i32).max(1);
+
+    let layout_for = |cr: &cairo::Context| {
+        let layout = pangocairo::functions::create_layout(cr);
+        layout.context().set_round_glyph_positions(false);
+        layout.set_font_description(Some(&font));
+        layout.set_width(width * pangocairo::pango::SCALE);
+        layout.set_ellipsize(EllipsizeMode::End);
+        layout.set_markup(markup);
+        layout
+    };
+
+    let surface = ImageSurface::create(cairo::Format::ARgb32, 0, 0)?;
+    let cr = cairo::Context::new(&surface)?;
+    let (w, h) = layout_for(&cr).pixel_size();
+    // a transparent pixel border: the label is sampled in perspective, and its edges stay clean
+    let pad = 2;
+    let (w, h) = (w.max(1) + 2 * pad, h.max(1) + 2 * pad);
+
+    let surface = ImageSurface::create(cairo::Format::ARgb32, w, h)?;
+    let cr = cairo::Context::new(&surface)?;
+    let layout = layout_for(&cr);
+    cr.set_source_rgba(0.925, 0.878, 0.933, 1.);
+    cr.move_to(f64::from(pad), f64::from(pad));
+    pangocairo::functions::show_layout(&cr, &layout);
+    drop(cr);
+
+    let data = surface.take_data().unwrap();
+    Ok(crate::render_helpers::texture::TextureBuffer::from_memory(
+        renderer,
+        &data,
+        smithay::reexports::gbm::Format::Argb8888,
+        (w, h),
+        false,
+        scale,
+        smithay::utils::Transform::Normal,
+        Vec::new(),
+    )?)
+}
