+            let (u, v) = (q.x / q.z, q.y / q.z);
+            if (0. ..=1.).contains(&u) && (0. ..=1.).contains(&v) {
+                return Some(Point::from((rect.loc.x + u * rect.size.w, rect.loc.y + v * rect.size.h)));
