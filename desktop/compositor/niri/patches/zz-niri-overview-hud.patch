+/// midve: number of columns in the overview's workspace grid.
+const OVERVIEW_GRID_COLS: usize = 2;
+
+/// midve: extra room above the grid for the HUD's mode switch, logical px at zoom 0.26.
+const OVERVIEW_GRID_TOP_ROOM: f64 = 26.;
+
+/// midve: how far the columns of cards turn towards the middle, degrees.
+const OVERVIEW_TILT_DEG: f64 = 16.;
+
+/// midve: extra room between grid rows for the card labels, logical px at zoom 0.26. With the
+/// row gap it holds the label (13 px type) and a margin above and below, so a label never
+/// reaches the next row's cards.
+const OVERVIEW_LABEL_ROOM: f64 = 16.;
+
+fn overview_label_room(open_zoom: f64) -> f64 {
+    OVERVIEW_LABEL_ROOM * open_zoom / 0.26
+}
+
+/// midve: time constant of a card turning to face the pointer, seconds.
+const HOVER_TAU: f64 = 0.07;
+
+/// midve: time constant of the lilac outline moving to another card, seconds.
+const GLOW_TAU: f64 = 0.075;
+/// midve: the glint across a card that turns to the pointer: it starts once the card is
+/// turning, takes GLINT_SECS to cross, and the card can't glint again for GLINT_REST after.
+const GLINT_DELAY: f64 = 0.04;
+const GLINT_SECS: f64 = 0.62;
+const GLINT_REST: f64 = 0.9;
+
+/// midve: length of the seat-and-flash when the overview has opened, seconds.
+const SEAT_SECS: f64 = 0.42;
+/// midve: the open overview's idle sway: at most this much extra turn, drift and depth (as a
+/// share of the output width). Slight on purpose: noticed, never watched.
+const SWAY_TURN_DEG: f64 = 0.9;
+const SWAY_DRIFT_PX: f64 = 3.;
+const SWAY_DEPTH: f64 = 0.006;
+
+/// midve: the grid cell (column, row) of a workspace index. A fractional index (a gesture, an
+/// interrupted switch) lies on the straight line between the two cards around it.
+fn overview_grid_cell(idx: f64, cols: usize) -> (f64, f64) {
+    let idx = idx.max(0.);
+    let lo = idx.floor();
+    let t = idx - lo;
+    let cell = |i: f64| {
+        let i = i as usize;
+        ((i % cols) as f64, (i / cols) as f64)
+    };
+    let a = cell(lo);
+    if t < 1e-9 {
+        return a;
+    }
+    let b = cell(lo + 1.);
+    (a.0 + (b.0 - a.0) * t, a.1 + (b.1 - a.1) * t)
+}
+
+/// midve: the grid row to centre for a (possibly fractional, animating) render index. Moving
+/// between workspaces in the same row keeps the row still; moving to the next row scrolls by one
+/// row while the index crosses from the row's last column to the next row's first.
+fn overview_grid_row(render_idx: f64, cols: usize) -> f64 {
+    let cols = cols as f64;
+    let row = (render_idx / cols).floor();
+    let within = render_idx - row * cols;
+    row + (within - (cols - 1.)).max(0.)
+}
