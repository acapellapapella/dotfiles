diff --git a/src/render_helpers/shaders/hud_tilt.frag b/src/render_helpers/shaders/hud_tilt.frag
new file mode 100644
index 00000000..e6eadc2a
--- /dev/null
+++ b/src/render_helpers/shaders/hud_tilt.frag
@@ -0,0 +1,73 @@
+// midve: one flank (half) of the overview HUD, turned in perspective by niri.
+//
+// tilt_input_to_uv maps the element's quad to the half's uv (the inverse of its homography);
+// tilt_uv_to_tex maps that uv into the HUD's offscreen texture (drawn at the client's buffer
+// scale). tilt_px is one physical pixel in quad coordinates, tilt_tex_px the texture's size in
+// texels; together they give each pixel's footprint for the filter below.
+
+precision highp float;
+
+#if defined(DEBUG_FLAGS)
+uniform float niri_tint;
+#endif
+
+varying vec2 niri_v_coords;
+uniform float niri_alpha;
+
+uniform sampler2D niri_tex;
+uniform mat3 tilt_input_to_uv;
+uniform mat3 tilt_uv_to_tex;
+uniform vec2 tilt_px;
+uniform vec2 tilt_tex_px;
+
+vec2 tex_at(vec2 at) {
+    vec3 q = tilt_input_to_uv * vec3(at, 1.0);
+    vec3 t = tilt_uv_to_tex * vec3(q.xy / q.z, 1.0);
+    return t.st;
+}
+
+vec4 tap(vec2 at) {
+    vec3 q = tilt_input_to_uv * vec3(at, 1.0);
+    if (q.z <= 0.0)
+        return vec4(0.0);
+    vec2 uv = q.xy / q.z;
+    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
+        return vec4(0.0);
+    vec3 t = tilt_uv_to_tex * vec3(uv, 1.0);
+    return texture2D(niri_tex, t.st);
+}
+
+// Adaptive supersampling over the pixel's own footprint on the texture: one bilinear tap where
+// the texture is magnified or 1:1 (no extra softening), and an n×m grid of taps (up to 4×4)
+// where the perspective squeezes several texels into one pixel, so receding text and lines
+// neither blur nor shimmer.
+vec4 filtered(vec2 c) {
+    vec2 t0 = tex_at(c);
+    vec2 du = (tex_at(c + vec2(tilt_px.x, 0.0)) - t0) * tilt_tex_px;
+    vec2 dv = (tex_at(c + vec2(0.0, tilt_px.y)) - t0) * tilt_tex_px;
+    int nx = int(clamp(ceil(length(du) - 0.15), 1.0, 4.0));
+    int ny = int(clamp(ceil(length(dv) - 0.15), 1.0, 4.0));
+    vec4 sum = vec4(0.0);
+    for (int j = 0; j < 4; j++) {
+        if (j >= ny) break;
+        for (int i = 0; i < 4; i++) {
+            if (i >= nx) break;
+            vec2 o = vec2((float(i) + 0.5) / float(nx) - 0.5, (float(j) + 0.5) / float(ny) - 0.5);
+            sum += tap(c + tilt_px * o);
+        }
+    }
+    return sum / float(nx * ny);
+}
+
+void main() {
+    vec2 c = niri_v_coords;
+    vec4 color = filtered(c);
+    color = color * niri_alpha;
+
+#if defined(DEBUG_FLAGS)
+    if (niri_tint == 1.0)
+        color = vec4(0.0, 0.2, 0.0, 0.2) + color * 0.8;
+#endif
+
+    gl_FragColor = color;
+}
