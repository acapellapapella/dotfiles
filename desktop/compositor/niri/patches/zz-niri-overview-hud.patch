+    /// The direction (unit vector) a bar leaves the screen in: towards its edge.
+    fn edge_bar_dir(&self) -> Option<Point<f64, Logical>> {
+        let state = self.surface.cached_state();
+        if !matches!(state.exclusive_zone, ExclusiveZone::Exclusive(z) if z > 0) {
+            return None;
+        }
+        let a = state.anchor;
+        let (t, b, l, r) = (
+            a.contains(Anchor::TOP),
+            a.contains(Anchor::BOTTOM),
+            a.contains(Anchor::LEFT),
+            a.contains(Anchor::RIGHT),
+        );
+        match (t, b, l, r) {
+            (true, false, l, r) if l == r => Some(Point::from((0., -1.))),
+            (false, true, l, r) if l == r => Some(Point::from((0., 1.))),
+            (t, b, true, false) if t == b => Some(Point::from((-1., 0.))),
+            (t, b, false, true) if t == b => Some(Point::from((1., 0.))),
+            _ => None,
