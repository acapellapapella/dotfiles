// Blur everywhere uses xray: it blurs only the wallpaper, once, and reuses the
// cached result instead of re-blurring whatever is behind each surface every
// frame. That keeps the overview (all workspaces at once) at full frame rate.

// Bar: translucent along the top edge; the wallpaper shows through blurred.
layer-rule {
    match namespace="^waybar$"
    background-effect {
        xray true
        blur true
    }
}

// Launcher: radius matches the rofi theme's window border-radius (22px).
layer-rule {
    match namespace="^rofi$"
    shadow {
        on
        softness 18
        spread 0
        offset x=0 y=10
        color "#0b060a80"
    }
    geometry-corner-radius 22
    background-effect {
        xray true
        blur true
        noise 0.02
        saturation 1.2
    }
}

// Notifications: no blur or shadow here. mako draws all notifications, and
// the gaps between them, on one surface, so niri would blur and shade one big
// rectangle around the whole stack. mako paints its own near-opaque drops.

// Overview HUD (overview-hud/): lives in the overview backdrop, behind the
// workspace cards. With the patch it gets the pointer where its widgets are.
layer-rule {
    match namespace="^midve-hud$"
    place-within-backdrop true
}
