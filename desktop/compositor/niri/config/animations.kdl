// Workspace switches and column scrolling ease in and out: a spring starts at
// full speed, which read as a jerk. The curve is nearly symmetric (peak speed
// ~1.9× the average, was 2.6× with 0.3 0 0.2 1 at 340 ms), so a workspace
// glides onto the monitor instead of snapping into place. The patched niri (zz-niri-overview-hud.patch)
// stretches them with distance (time ∝ √distance, up to 2×), so jumping over
// one doesn't run twice as fast. A switch interrupted by the next key repeat or
// wheel step keeps its speed instead of restarting from rest (also the patch);
// without that, every step braked and set off again. Window movement and resizing stay on
// critically damped springs (damping-ratio 1.0): no wobble, smooth when
// interrupted mid-way.

animations {
    workspace-switch {
        duration-ms 420
        curve "cubic-bezier" 0.42 0.0 0.35 1.0
    }

    horizontal-view-movement {
        duration-ms 360
        curve "cubic-bezier" 0.42 0.0 0.35 1.0
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=850 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=850 epsilon=0.0001
    }

    // Windows surface: they rise 14px into place while fading in and growing
    // from 97%, and sink back 10px while fading out. The downward motion
    // matches the lowered window shadow (layout.kdl).
    window-open {
        duration-ms 260
        curve "cubic-bezier" 0.16 1 0.3 1
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float scale = mix(0.97, 1.0, p);
                float rise = (1.0 - p) * 14.0 / size_geo.y;
                vec2 c = (coords_geo.xy - vec2(0.5, 0.5 + rise)) / scale + vec2(0.5);
                if (c.x < 0.0 || c.x > 1.0 || c.y < 0.0 || c.y > 1.0)
                    return vec4(0.0);
                vec3 coords_tex = niri_geo_to_tex * vec3(c, 1.0);
                return texture2D(niri_tex, coords_tex.st) * p;
            }
        "
    }

    window-close {
        duration-ms 180
        curve "cubic-bezier" 0.4 0 0.7 0.2
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float scale = mix(1.0, 0.98, p);
                float sink = p * 10.0 / size_geo.y;
                vec2 c = (coords_geo.xy - vec2(0.5, 0.5 + sink)) / scale + vec2(0.5);
                if (c.x < 0.0 || c.x > 1.0 || c.y < 0.0 || c.y > 1.0)
                    return vec4(0.0);
                vec3 coords_tex = niri_geo_to_tex * vec3(c, 1.0);
                return texture2D(niri_tex, coords_tex.st) * (1.0 - p);
            }
        "
    }

    // The same curve and time as a workspace switch. A spring starts at full
    // speed (the first frame jumped a third of the way) and settled in ~0.2 s,
    // long before the camera reached the clicked card, so the full-size view
    // kept sliding after the zoom. Clicking a card runs the switch on this
    // exact animation (the patch keeps it unstretched), so both end together.
    overview-open-close {
        duration-ms 420
        curve "cubic-bezier" 0.42 0.0 0.35 1.0
    }

    screenshot-ui-open {
        duration-ms 200
        curve "cubic-bezier" 0.16 1 0.3 1
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }

    config-notification-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=1.0 stiffness=600 epsilon=0.001
    }
}
